# --- Database ---
# Dev (host npm run dev): app talks directly to localhost:5433 (mapped by the bundled db service).
# Coolify production: set DATABASE_URL in Coolify's env panel to the managed Postgres URL,
# e.g. postgres://USER:PASS@yssskgs8o48cs08k0o48ss4s:5432/gradnadlanu
DATABASE_URL=postgres://gradnadlanu:gradnadlanu@localhost:5433/gradnadlanu

# Postgres credentials — only used by the bundled `db` service (dev profile).
# Production reads its credentials embedded in DATABASE_URL.
POSTGRES_USER=gradnadlanu
POSTGRES_PASSWORD=gradnadlanu
POSTGRES_DB=gradnadlanu

# Toggle the bundled db service when running `docker compose up`.
# Leave unset in production so only the `app` service starts.
COMPOSE_PROFILES=dev

# --- Server ---
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# Dev-only: Vite dev server origin. In production the API serves the SPA, leave blank.
CORS_ORIGIN=http://localhost:5173

# --- Seeded admin ---
# Hashed at seed time — change BEFORE running `npm run db:seed` (or the first boot
# with RUN_SEED_ON_BOOT=true) or the default password gets baked in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Production / Coolify ---
# Public hostname Traefik should route to this app.
APP_DOMAIN=gradnadlanu.example.com

# Run the seed once on first boot to load the 18 starter locations.
# Flip back to false after the first successful deploy.
RUN_SEED_ON_BOOT=false

# Override host port mappings if 3000 / 5433 are taken locally.
# APP_HOST_PORT=3000
# DB_HOST_PORT=5433
