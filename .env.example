# --- Database ---
# Dev (host npm run dev): app talks directly to localhost:5433 (mapped by the bundled db service).
# Coolify production: set DATABASE_URL in Coolify's env panel to the managed Postgres URL,
# e.g. postgres://USER:PASS@yssskgs8o48cs08k0o48ss4s:5432/gradnadlanu
DATABASE_URL=postgres://gradnadlanu:gradnadlanu@localhost:5433/gradnadlanu

# Postgres credentials — only used by the bundled `db` service (dev profile).
# Production reads its credentials embedded in DATABASE_URL.
# Required: the compose file refuses to start the dev DB without these.
# Pick a strong password for shared/team-dev environments.
POSTGRES_USER=gradnadlanu
POSTGRES_PASSWORD=replace-with-a-strong-dev-password
POSTGRES_DB=gradnadlanu

# Toggle the bundled db service when running `docker compose up`.
# Leave unset in production so only the `app` service starts.
COMPOSE_PROFILES=dev

# --- Server ---
PORT=3000
# REQUIRED. Must be 32+ chars and not the placeholder below — the server refuses
# to boot otherwise. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Dev-only: Vite dev server origin. In production the API serves the SPA, leave blank.
# Accepts a single origin or a comma-separated list (no spaces required around commas).
# In production each entry MUST be https:// (no "*"). Examples:
#   CORS_ORIGIN=https://gradnadlanu.example.com
#   CORS_ORIGIN=https://gradnadlanu.example.com,https://staging.gradnadlanu.example.com
CORS_ORIGIN=http://localhost:5173

# --- Seeded admin ---
# Hashed at seed time — change BEFORE running `npm run db:seed` (or the first boot
# with RUN_SEED_ON_BOOT=true) or the default password gets baked in.
# In production the server REQUIRES ADMIN_PASSWORD to be set, 12+ chars, and not a
# well-known weak value ("admin", "password", "123456", ...).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Email / verification (Resend) ---
# Get an API key at https://resend.com/api-keys. If left blank in dev, the server
# logs the verification URL to the console instead of sending an email — so you
# can test registration without configuring SMTP. In production this MUST be set.
RESEND_API_KEY=

# Sender used for verification emails. The domain (everything after @) must be
# verified in Resend (SPF + DKIM DNS records) or delivery fails. Format accepts
# either a bare address or "Name <addr@domain>".
EMAIL_FROM=Grad na dlanu <noreply@zabari.net>

# Base URL the verification link points at. Should be the public host where the
# SPA is served — e.g. https://zabari.net in prod, http://localhost:5173 in dev.
# When unset, falls back to https://${APP_DOMAIN} (prod) or http://localhost:5173 (dev).
APP_URL=http://localhost:5173

# --- Production / Coolify ---
# Public hostname Traefik should route to this app.
APP_DOMAIN=gradnadlanu.example.com

# Run the seed once on first boot to load the 18 starter locations.
# Flip back to false after the first successful deploy.
RUN_SEED_ON_BOOT=false

# Override host port mappings if 3000 / 5433 are taken locally.
# APP_HOST_PORT=3000
# DB_HOST_PORT=5433
